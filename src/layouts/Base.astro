---
import '../styles/global.css';
import { site } from '../config';

interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article'; wide?: boolean }
const { title, description = site.description, image = site.heroImage, type = 'website', wide = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const path = Astro.url.pathname;
// URLs absolutas para canonical y Open Graph (dependen de `site` en astro.config.mjs).
const canonical = new URL(path, Astro.site);
const imageUrl = new URL(image, Astro.site);
const nav = [
  { href: '/articulos/', label: 'Artículos' },
  { href: '/sobre-mi/', label: 'Sobre mí' },
  { href: '/sesiones/', label: 'Sesiones' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`Artículos de ${site.name}`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="es_PE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{site.name}</a>
        <nav aria-label="Principal">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <slot name="hero" />
    <main><div class:list={['wrap', { 'wrap--wide': wide }]}><slot /></div></main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="site-footer__grid">
          <div>
            <a class="brand" href="/">{site.name}</a>
            <p class="site-footer__tagline">{site.tagline}</p>
          </div>
          <nav aria-label="Pie de página">
            <strong>Navegación</strong>
            <a href="/">Inicio</a>
            {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          </nav>
          <div>
            <strong>Conecta</strong>
            <a href={site.linkedin} rel="noopener" target="_blank">LinkedIn</a>
            <a href="/sesiones/">Agendar una sesión</a>
            <a href="/rss.xml">RSS</a>
          </div>
        </div>
        <div class="site-footer__bottom">
          <span>© {new Date().getFullYear()} {site.name}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
