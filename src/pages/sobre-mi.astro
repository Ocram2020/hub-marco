---
// Sobre mí: página armada por bloques. Marco los edita, añade, quita y reordena desde
// Pages CMS ("Sobre mí" → src/data/sobre-mi.json).
import Base from '../layouts/Base.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { sobreMi } from '../lib/contenido';
---
<Base title={sobreMi.seo_titulo} description={sobreMi.seo_descripcion || undefined}>
  <BlockRenderer bloques={sobreMi.bloques} tituloRespaldo={sobreMi.seo_titulo} />
</Base>
