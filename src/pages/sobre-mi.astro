---
import Base from '../layouts/Base.astro';
import { site } from '../config';
---
<Base title="Sobre mí">
    <div class="about">
    <figure class="portrait">
      <img src={site.photo} alt={`Foto de ${site.name}`} width="400" height="500" />
    </figure>
    <div>
      <h1>Sobre mí</h1>
  <p class="note">Texto provisional. Reemplazar con la biografía real de {site.name}: a qué se dedica, su experiencia y qué puede esperar quien lo lea.</p>
  <p class="prose">Aquí irá la presentación de {site.name}, en tres o cuatro párrafos, escrita en primera persona.</p>
  <p><a href={site.linkedin} rel="noopener">Ver perfil en LinkedIn</a></p>
</Base>
