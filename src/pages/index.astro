---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { site } from '../config';

const posts = (await getCollection('articulos', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base>
  <h1>{site.name}</h1>
  <p class="lead">{site.tagline}</p>
  <div class="actions">
    <a class="btn primary" href="/articulos/">Leer artículos</a>
    <a class="btn secondary" href="/sesiones/">Agendar una sesión</a>
  </div>

  <h2 class="section-title">Últimos artículos</h2>
  <PostList posts={posts.slice(0, 6)} />
  {posts.length > 6 && <a class="more" href="/articulos/">Ver todos los artículos</a>}
</Base>
