---
import type { CollectionEntry } from 'astro:content';
import { site } from '../config';
interface Props { posts: CollectionEntry<'articulos'>[] }
const { posts } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('es-PE', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const coverOf = (p) => p.data.cover || (site.showCoverFallback ? site.coverFallback : undefined);
---
{posts.length === 0 ? (
  <p class="empty">Todavía no hay artículos publicados.</p>
) : (
  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
        <div>
          {coverOf(p) && <img class="thumb" src={coverOf(p)} alt="" width="160" height="84" loading="lazy" />}
          <h3><a href={`/articulos/${p.id}/`}>{p.data.title}</a></h3>
          {p.data.summary && <p>{p.data.summary}</p>}
        </div>
      </li>
    ))}
  </ul>
)}
