---
import type { CollectionEntry } from 'astro:content';
import { site } from '../config';
interface Props { posts: CollectionEntry<'articulos'>[] }
const { posts } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('es-PE', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const coverOf = (p: CollectionEntry<'articulos'>) => p.data.cover || (site.showCoverFallback ? site.coverFallback : undefined);
---
{posts.length === 0 ? (
  <p class="empty">Todavía no hay artículos publicados.</p>
) : (
  <ul class="post-list">
    {posts.map((p) => {
      const cover = coverOf(p);
      const url = `/articulos/${p.id}/`;
      return (
        <li class="post-card">
          <div class="post-card__body">
            <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
            <h3><a href={url}>{p.data.title}</a></h3>
            {p.data.summary && <p>{p.data.summary}</p>}
            <div class="post-card__meta">
              <a class="post-card__read" href={url}>Leer artículo</a>
              {p.data.linkedin && (
                <a class="post-card__linkedin" href={p.data.linkedin} rel="noopener" target="_blank">Comenta en LinkedIn</a>
              )}
            </div>
          </div>
          {cover && (
            <a class="post-card__media" href={url} tabindex="-1" aria-hidden="true">
              <img src={cover} alt="" width="480" height="360" loading="lazy" decoding="async" />
            </a>
          )}
        </li>
      );
    })}
  </ul>
)}
