---
// Formulario de newsletter (Kit) incrustado en la página, sin popup.
// Título y texto vacíos usan los de "Ajustes del sitio". `uid` evita ids repetidos si aparece más de una vez.
import { site } from '../config';
interface Props { title?: string; text?: string; uid?: string | number }
const { title, text, uid } = Astro.props;
const titulo = title || site.newsletter.titulo;
const texto = text || site.newsletter.texto;
const sufijo = uid === undefined ? '' : `-${uid}`;
---
<section class="newsletter" aria-labelledby={`newsletter-title${sufijo}`}>
  <h2 id={`newsletter-title${sufijo}`}>{titulo}</h2>
  {texto && <p>{texto}</p>}
  <form action={site.newsletterAction} method="post" data-sv-form={site.newsletterFormId} data-uid={site.newsletterUid} data-format="inline" data-version="5">
    <label class="sr-only" for={`newsletter-email${sufijo}`}>Correo electrónico</label>
    <input id={`newsletter-email${sufijo}`} type="email" name="email_address" required autocomplete="email" placeholder="Tu correo electrónico" />
    <button class="btn primary" type="submit">{site.newsletter.boton}</button>
  </form>
  {site.newsletter.nota && <p class="newsletter__note">{site.newsletter.nota}</p>}
</section>
